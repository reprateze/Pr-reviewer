# Token de acesso ao GitHub, usado para buscar arquivos do PR e postar
# comentários. Precisa de permissão de leitura/escrita em Pull Requests
# (um Personal Access Token classic com escopo "repo" funciona).
GITHUB_TOKEN=

# Chave da API do provedor de LLM. No MVP atual, é a chave do Google AI
# Studio (Gemini) — https://aistudio.google.com/apikey
LLM_API_KEY=

# Nome do modelo do Gemini a ser usado. Opcional: se não definido, usa
# "gemini-2.0-flash" (ver app/config.py).
LLM_MODEL=gemini-2.0-flash

# Onde persistir as sugestões geradas e o feedback dos devs sobre elas.
# Opcional: se não definido, usa SQLite local (./data.db) — ótimo para
# desenvolver ou rodar o experimento do TCC sem depender de infra externa.
# Em produção, aponte para um Postgres (Render/Supabase), ex:
# postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=sqlite:///./data.db

# Segredo compartilhado com o GitHub para validar a assinatura dos webhooks
# recebidos em /webhook/github (usado para capturar feedback dos devs sobre
# as sugestões). Configurado ao criar o webhook em Settings > Webhooks do
# repositório. Opcional: se vazio, a verificação de assinatura é pulada
# (ok para desenvolver local, não recomendado em produção).
GITHUB_WEBHOOK_SECRET=

# Tamanho máximo (em caracteres) do contexto extra (dependências + testes
# relacionados) enviado no prompt da IA. Opcional (padrão: 2000).
MAX_EXTRA_CONTEXT_CHARS=2000

# Quantas funções (no máximo) são analisadas por arquivo alterado em cada
# PR — cada uma custa 1 requisição ao LLM. Opcional (padrão: 2).
MAX_FUNCTIONS_PER_PR=2

# Intervalo mínimo (segundos) entre chamadas ao LLM, para respeitar o limite
# de requisições por minuto (RPM) do modelo configurado em LLM_MODEL.
# Modelos "Flash Lite" costumam ter RPM maior (ex: 15) que os "Flash"
# comuns (ex: 5) — ajuste conforme o modelo. Opcional (padrão: 15).
LLM_MIN_REQUEST_INTERVAL_SECONDS=15

# ==============================
# RAG (recuperação contextual por embeddings)
# ==============================

# Liga a busca semântica de trechos parecidos do repositório para enriquecer
# o prompt. Fica desligado por padrão justamente para permitir comparar as
# análises COM e SEM esse contexto (o experimento precisa dos dois cenários).
RAG_ENABLED=false

# Modelo de embeddings (cota separada da cota de geração de texto).
EMBEDDING_MODEL=gemini-embedding-001

# Tamanho do vetor. O modelo devolve 3072 por padrão; truncar para 768
# reduz em 4x o espaço no banco e o custo de comparar vetores.
EMBEDDING_DIMENSIONS=768

# Quantos trechos semelhantes são recuperados por função analisada.
RAG_TOP_K=3

# Teto de arquivos .py indexados por repositório (cada arquivo custa 1
# chamada à API do GitHub + 1 chamada de embedding em lote).
RAG_MAX_FILES_TO_INDEX=50

# Orçamento de caracteres só para o bloco recuperado, somado ao
# MAX_EXTRA_CONTEXT_CHARS quando o RAG está ligado.
RAG_MAX_CONTEXT_CHARS=1500
