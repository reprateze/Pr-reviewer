# Token de acesso ao GitHub, usado para buscar arquivos do PR e postar
# comentários. Precisa de permissão de leitura/escrita em Pull Requests
# (um Personal Access Token classic com escopo "repo" funciona).
GITHUB_TOKEN=

# Chave da API do provedor de LLM. No MVP atual, é a chave do Google AI
# Studio (Gemini) — https://aistudio.google.com/apikey
LLM_API_KEY=

# Nome do modelo do Gemini a ser usado. Opcional: se não definido, usa
# "gemini-2.0-flash" (ver app/config.py).
LLM_MODEL=gemini-2.0-flash

# Onde persistir as sugestões geradas e o feedback dos devs sobre elas.
# Opcional: se não definido, usa SQLite local (./data.db) — ótimo para
# desenvolver ou rodar o experimento do TCC sem depender de infra externa.
# Em produção, aponte para um Postgres (Render/Supabase), ex:
# postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=sqlite:///./data.db

# Segredo compartilhado com o GitHub para validar a assinatura dos webhooks
# recebidos em /webhook/github (usado para capturar feedback dos devs sobre
# as sugestões). Configurado ao criar o webhook em Settings > Webhooks do
# repositório. Opcional: se vazio, a verificação de assinatura é pulada
# (ok para desenvolver local, não recomendado em produção).
GITHUB_WEBHOOK_SECRET=

# Tamanho máximo (em caracteres) do contexto extra (dependências + testes
# relacionados) enviado no prompt da IA. Opcional (padrão: 2000).
MAX_EXTRA_CONTEXT_CHARS=2000
