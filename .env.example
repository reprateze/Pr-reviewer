# Token de acesso ao GitHub, usado para buscar arquivos do PR e postar
# comentários. Precisa de permissão de leitura/escrita em Pull Requests
# (um Personal Access Token classic com escopo "repo" funciona).
GITHUB_TOKEN=

# Chave da API do provedor de LLM. No MVP atual, é a chave do Google AI
# Studio (Gemini) — https://aistudio.google.com/apikey
LLM_API_KEY=

# Nome do modelo do Gemini a ser usado. Opcional: se não definido, usa
# "gemini-2.0-flash" (ver app/config.py).
LLM_MODEL=gemini-2.0-flash
